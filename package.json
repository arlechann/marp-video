{
    "name": "marp-video",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": "24.21.0"
    },
    "packageManager": "npm@12.1.0",
    "bin": {
        "marp-video": "dist/cli-entry.js"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "build": "tsc --project tsconfig.build.json",
        "test": "node --test --test-isolation=none tests/*.test.ts",
        "start": "node dist/cli-entry.js",
        "lint": "eslint src tests",
        "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" package.json eslint.config.mjs prettier.config.mjs",
        "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" package.json eslint.config.mjs prettier.config.mjs"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "24.19.0",
        "@typescript/native": "npm:typescript@7.0.2",
        "eslint": "10.10.0",
        "eslint-config-prettier": "10.1.8",
        "prettier": "3.9.9",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "typescript-eslint": "8.70.1"
    },
    "dependencies": {
        "@marp-team/marp-cli": "4.5.1",
        "markdown-it": "15.0.2",
        "yaml": "2.9.1"
    }
}
